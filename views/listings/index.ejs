<% layout("/layout/boilerplate") %>

<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top:2rem;
    opacity: 0.7;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }

</style>
<body>
    <div id="filters">
          <div class="filter">
            <div><i class="fa-solid fa-fire"></i>
                <p><b>Trending</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-bed"></i>
                <p><b>Room</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i>
                <p><b>Iconic City</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-mountain"></i>
                <p><b>Mountain</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i>
                <p><b>Castles</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i>
                <p><b>Pools</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-tents"></i>
                <p><b>Camping</b></p></div>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-tractor"></i>
                <p><b>Farms</b></p></div>
          </div>
          
          <div class="filter">
            <div><i class="fa-solid fa-snowflake"></i>
                <p><b>Artic</b></p></div>
          </div>
          
          


    </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

   
<% for(let listing of allListing){%>
    
  <div class="card col listing-card" >
    <a href="/listings/<%=listing._id%>" class="listing-link"><img src="<%= listing.image.url%>" class="card-img-top" alt="listing_image" style="height:20rem;"></a>
    
    <div class="card-body">
    <a href="/listings/<%=listing._id%>"class="listing-link"><h5 class="card-title"><%= listing.title%></h5></a>
    <p class="card-text">
        <br>
        ₹<%=  listing.price%>/night 
    </p>
    </div>
  </div>

<%}%>
</div>
    
</body>
